{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "organizeImports": {
        "enabled": true
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "files": {
        "ignore": [
            "dist",
            "*.svelte",
            "playground/.svelte-kit",
            "playground/build",
            "packages/libraw.wasm/src/libraw-types.ts"
        ]
    }
}
